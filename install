#!/usr/bin/env bash

set -euo pipefail

DOTFILES="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
OS_NAME="$(uname -s)"

COMMON_PACKAGES=(git kitty nu nvim starship yesman zellij)
MACOS_PACKAGES=(aerospace)

if ! command -v stow >/dev/null 2>&1; then
  echo "Error: GNU Stow is required but not installed."
  echo "Install it first: brew install stow"
  exit 1
fi

# Cleanup legacy links from pre-stow layout.
legacy_links=(
  "$HOME/.config/kitty"
  "$HOME/.config/nvim"
  "$HOME/.config/zellij"
  "$HOME/.config/starship.toml"
  "$HOME/.config/yesman"
)

for link in "${legacy_links[@]}"; do
  if [ -L "$link" ]; then
    rm "$link"
  fi
done

mkdir -p "$HOME/.config/yesman"

if [ "$OS_NAME" = "Darwin" ]; then
  if [ -e "$HOME/.aerospace.toml" ] && [ ! -L "$HOME/.aerospace.toml" ]; then
    stow --adopt -d "$DOTFILES" -t "$HOME" "${MACOS_PACKAGES[@]}"
  else
    stow -d "$DOTFILES" -t "$HOME" "${MACOS_PACKAGES[@]}"
  fi
fi

stow -d "$DOTFILES" -t "$HOME" "${COMMON_PACKAGES[@]}"

if [ "$OS_NAME" = "Linux" ] && command -v omarchy >/dev/null 2>&1; then
  stow -d "$DOTFILES" -t "$HOME" omarchy
fi

# Preserve an existing machine-local Pi settings file while still stowing the
# durable extensions, prompts, and skills from the repository.
if [ -e "$HOME/.pi/agent/settings.json" ] && [ ! -L "$HOME/.pi/agent/settings.json" ]; then
  echo "Preserving existing machine-local ~/.pi/agent/settings.json"
  stow --ignore='settings\\.json$' -d "$DOTFILES" -t "$HOME" pi
else
  stow -d "$DOTFILES" -t "$HOME" pi
fi

# Remove links left by the retired dotfiles theme generator.
for legacy_pi_theme in \
  fallout-terminal-dark.json \
  fallout-terminal-light.json \
  fallout-terminal.json \
  nord-dark.json \
  nord-light.json \
  README.md; do
  legacy_pi_theme_path="$HOME/.pi/agent/themes/$legacy_pi_theme"
  if [ -L "$legacy_pi_theme_path" ]; then
    rm "$legacy_pi_theme_path"
  fi
done

# Link platform-specific git config.
gitconfig_platform="$HOME/.gitconfig-platform"
if [ "$OS_NAME" = "Darwin" ]; then
  gitconfig_source="$DOTFILES/gitconfig-platform.mac"
else
  gitconfig_source="$DOTFILES/gitconfig-platform.linux"
fi

if [ -L "$gitconfig_platform" ]; then
  rm "$gitconfig_platform"
elif [ -e "$gitconfig_platform" ]; then
  mv "$gitconfig_platform" "$gitconfig_platform.bak"
fi

ln -s "$gitconfig_source" "$gitconfig_platform"

if [ "$OS_NAME" = "Linux" ]; then
  mkdir -p "$HOME/.config/mise"
  mise_global="$HOME/.config/mise/config.toml"
  mise_source="$DOTFILES/mise.vps.toml"

  if [ -L "$mise_global" ]; then
    rm "$mise_global"
  elif [ -e "$mise_global" ]; then
    mv "$mise_global" "$mise_global.bak"
  fi

  ln -s "$mise_source" "$mise_global"

  # Create yesman UI env file stub if it doesn't exist. This file is intentionally
  # outside the stowed dotfiles tree so the UI password stays machine-local.
  yesman_env="$HOME/.config/yesman.env"
  if [ ! -e "$yesman_env" ]; then
    printf '# yesman UI credentials\nYESMAN_UI_PASSWORD=changeme\n' > "$yesman_env"
    chmod 600 "$yesman_env"
    echo "Created $yesman_env — update the password before starting yesmand.service."
  fi

  mkdir -p "$HOME/.local/share/yesman/runtime"
fi

if [ "$OS_NAME" = "Darwin" ]; then
  # Nushell on macOS reads from ~/Library/Application Support/nushell by default.
  nu_default_dir="$HOME/Library/Application Support/nushell"
  mkdir -p "$nu_default_dir"

  for nu_file in config.nu env.nu mise.nu; do
    target="$nu_default_dir/$nu_file"
    source_file="$DOTFILES/nu/.config/nushell/$nu_file"

    if [ -L "$target" ]; then
      rm "$target"
    elif [ -e "$target" ]; then
      mv "$target" "$target.bak"
    fi

    ln -s "$source_file" "$target"
  done
fi

mkdir -p "$HOME/.config/nushell"

for local_nu_file in local.nu secrets.nu; do
  local_nu_path="$HOME/.config/nushell/$local_nu_file"
  if [ ! -e "$local_nu_path" ]; then
    if [ "$local_nu_file" = "secrets.nu" ]; then
      printf '# secrets for this machine\n' > "$local_nu_path"
    else
      printf '# local machine overrides\n' > "$local_nu_path"
    fi
  fi
done

mkdir -p "$HOME/.cache/starship"
if [ ! -e "$HOME/.cache/starship/init.nu" ]; then
  cat <<'EOF' > "$HOME/.cache/starship/init.nu"
export-env {}
EOF
fi

if [ "$OS_NAME" = "Linux" ] && command -v omarchy >/dev/null 2>&1; then
  zellij_runtime="$HOME/.local/state/dotfiles/zellij"
  mkdir -p "$zellij_runtime"
  ln -sfn "$HOME/.config/zellij/config.kdl" "$zellij_runtime/config.kdl"
  ln -sfn "$HOME/.config/zellij/layouts" "$zellij_runtime/layouts"
  ln -sfn "$HOME/.local/state/omarchy/current/theme" "$zellij_runtime/themes"

  omarchy theme refresh
  if [ -f "$HOME/.pi/agent/settings.json" ] && [ ! -L "$HOME/.pi/agent/settings.json" ]; then
    omarchy-theme-set-pi --activate
  fi
fi

echo "Done. Dotfiles linked with stow."
